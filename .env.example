# GreetBot Environment Configuration
# Copy this file to .env and fill in your values

# ==========================
# REQUIRED
# ==========================

# Groq API Key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ==========================
# TELEGRAM NOTIFICATIONS
# ==========================
# Create a bot via @BotFather on Telegram to get the token.
# To get your chat ID: send any message to your bot, then visit:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================
# OPTIONAL
# ==========================

# OpenWeatherMap API Key — get one free at https://openweathermap.org/api
# Required for the weather skill
WEATHER_API_KEY=your_weather_api_key_here

# Default city for weather queries
WEATHER_CITY=Hyderabad

# ==========================
# OFFLINE LLM (OLLAMA)
# ==========================
# USE_OLLAMA=true
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=llama3

# Raspberry Pi performance / audio safety
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# STT_MODEL=base
# TTS_ENGINE=piper
# PIPER_MODEL_PATH=/home/pi/greetbot/assets/voices/en_US-lessac-medium.onnx
# LISTEN_TIMEOUT_SECONDS=20
# MAX_RECORDING_SECONDS=12
